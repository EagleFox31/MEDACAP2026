# Copier en .env.server puis : docker compose -f docker-compose.server.yml --env-file .env.server up -d --build
# URL publique de la machine (utilisée dans les liens des mails)
MEDACAP_PUBLIC_URL=http://10.68.0.15
# Port HTTP exposé sur le serveur
HTTP_PORT=80
# Dossier (sur le serveur) où écrire les sauvegardes quotidiennes
BACKUP_DIR=./backups
# Relais SMTP sans authentification utilisé par mail() (msmtp)
MEDACAP_SMTP_HOST=smtp.cfao.corp
MEDACAP_SMTP_PORT=25
