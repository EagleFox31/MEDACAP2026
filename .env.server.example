# Copier en .env.server, remplir, puis : ./deploy.sh (voir docs/deploiement-serveur.md)
# URL publique de la machine (utilisée dans les liens des mails)
MEDACAP_PUBLIC_URL=http://10.68.0.15:8010
# Port HTTP exposé sur le serveur : bloc 8010-8019 réservé à MEDACAP (convention de ports de la .15)
HTTP_PORT=8010
# Branche déployée par ./deploy.sh
DEPLOY_BRANCH=main
# Dossier (sur le serveur) où écrire les sauvegardes quotidiennes ; la plus récente sert à recréer une base perdue
BACKUP_DIR=./backups
# Dossier de l'archive initiale (*.archive.gz), utilisée seulement si BACKUP_DIR est vide et la base absente
SEED_DIR=./seed
# Relais SMTP sans authentification utilisé par mail() (msmtp)
MEDACAP_SMTP_HOST=smtp.cfao.corp
MEDACAP_SMTP_PORT=25
# Destinataire des mails d'erreur fatale (vide = jakaa-ext@cfao.com, off = aucun mail)
MEDACAP_ERROR_MAIL=
# Proxy sortant (git fetch, construction de l'image). Laisser vide sans proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.cfao.corp,10.68.0.0/16
